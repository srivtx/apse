{
  "name": "apse",
  "version": "0.0.1",
  "description": "A WebGPU renderer built to be fast, small, and correct by construction.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.3.9",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./math": {
      "types": "./dist/math/index.d.ts",
      "default": "./dist/math/index.js"
    },
    "./geometry": {
      "types": "./dist/geometry/index.d.ts",
      "default": "./dist/geometry/index.js"
    },
    "./material": {
      "types": "./dist/material/index.d.ts",
      "default": "./dist/material/index.js"
    },
    "./scene": {
      "types": "./dist/scene/index.d.ts",
      "default": "./dist/scene/index.js"
    },
    "./render": {
      "types": "./dist/render/index.d.ts",
      "default": "./dist/render/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "core": ["./dist/core/index.d.ts"],
      "math": ["./dist/math/index.d.ts"],
      "geometry": ["./dist/geometry/index.d.ts"],
      "material": ["./dist/material/index.d.ts"],
      "scene": ["./dist/scene/index.d.ts"],
      "render": ["./dist/render/index.d.ts"]
    }
  },
  "files": ["dist", "README.md", "AGENTS.md", "ARCHITECTURE.md"],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "bench": "bun run bench/run.ts",
    "verify": "bun run typecheck && bun test && bun run build && bun run scripts/size-gate.ts",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@webgpu/types": "^0.1.74",
    "esbuild": "^0.28.2",
    "puppeteer": "^24.0.0",
    "three": "^0.186.1",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "webgpu",
    "graphics",
    "renderer",
    "3d",
    "wgsl",
    "gpu"
  ]
}
